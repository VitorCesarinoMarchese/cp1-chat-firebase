# Firebase web app configuration
EXPO_PUBLIC_FIREBASE_API_KEY=your-api-key
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
EXPO_PUBLIC_FIREBASE_DATABASE_URL=https://your-project-default-rtdb.firebaseio.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=000000000000
EXPO_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:0000000000000000

# OAuth client IDs used by expo-auth-session for Google
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your-web-client-id.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=your-ios-client-id.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=your-android-client-id.apps.googleusercontent.com

# Apple Service ID used by the web/Android OAuth fallback.
# Native iOS Sign in with Apple uses the iOS app capability.
EXPO_PUBLIC_APPLE_SERVICE_ID=com.example.cp1chat.service

# Required for native fallback flows. Use an HTTPS page that relays the
# OAuth response to cp1chat://auth. Leave empty when testing native iOS only.
EXPO_PUBLIC_APPLE_REDIRECT_URI=https://your-project.web.app/apple-auth.html
